LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_llm_model_id
# Analyst switches to this structured-output model after a timeout, network
# failure, or invalid structured response from the primary model.
LLM_ANALYST_FALLBACK_MODEL=gpt-oss-20b
LLM_BASE_URL=https://your-llm-provider.example/v1
# Real workflow requires AITUNNEL strict Structured Outputs. List only models whose
# current provider documentation confirms support for response_format=json_schema.
LLM_STRUCTURED_OUTPUT_MODELS=deepseek-v4-flash,deepseek/deepseek-v4-flash,gpt-oss-20b,openai/gpt-oss-20b
# Critic uses this AITUNNEL structured-output fallback only if the primary model
# ends the response at its output limit (finish_reason=length).
LLM_CRITIC_MODEL=deepseek-v4-flash
LLM_CRITIC_TIMEOUT_MS=180000
LLM_CRITIC_FALLBACK_MODEL=gpt-oss-20b
LLM_CRITIC_FALLBACK_CONTEXT_CHARS=48000
LLM_MAX_OUTPUT_TOKENS_CRITIC_FALLBACK=5000
LLM_MOCK=false
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here
ALLOWED_TELEGRAM_USER_IDS=
FREE_ANALYSES_LIMIT=5
FREE_ANALYSES_WINDOW_HOURS=24
TELEGRAM_MAX_FILE_SIZE_MB=10
# Keep source resume and vacancy text out of disk output by default. Enable only for local debugging of synthetic data.
SAVE_INPUT_TEXT=false
MAX_REVISION_CYCLES=0
ANALYSIS_MODE=fast
LLM_STEP_TIMEOUT_MS=120000
LLM_TRANSIENT_RETRY_MAX_ATTEMPTS=2
ANALYSIS_TOTAL_TIMEOUT_MS=300000
LLM_MAX_OUTPUT_TOKENS_ANALYST=4000
LLM_MAX_OUTPUT_TOKENS_PRODUCER=5000
LLM_MAX_OUTPUT_TOKENS_CRITIC=5000
LLM_MAX_OUTPUT_TOKENS_ORCHESTRATOR_FINAL=8000

# Local PostgreSQL only. Override these values in your untracked .env file when needed.
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Better Auth. Generate BETTER_AUTH_SECRET with a cryptographically secure source;
# it must be at least 32 characters and must never be committed.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_ORIGIN=http://localhost
# Public HTTP port used by Docker Compose. On a VPS, use 80 behind TLS/reverse proxy.
HTTP_PORT=80
# Resend API key and a verified production sender address. Keep both values only in .env/secret storage.
RESEND_API_KEY=re_replace-with-your-resend-api-key
AUTH_EMAIL_FROM=no-reply@auth.example.com
# Set this only to a header that your production reverse proxy overwrites.
AUTH_CLIENT_IP_HEADER=x-real-ip
