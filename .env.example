LLM_API_KEY=rusgpt-YOUR_API_KEY
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LLM_BASE_URL=https://rus-gpt.com/api/v1
LLM_MOCK=false
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here
ALLOWED_TELEGRAM_USER_IDS=
FREE_ANALYSES_LIMIT=5
FREE_ANALYSES_WINDOW_HOURS=24
TELEGRAM_MAX_FILE_SIZE_MB=10
# Keep source resume and vacancy text out of disk output by default. Enable only for local debugging of synthetic data.
SAVE_INPUT_TEXT=false
MAX_REVISION_CYCLES=0
ANALYSIS_MODE=fast
LLM_STEP_TIMEOUT_MS=120000
ANALYSIS_TOTAL_TIMEOUT_MS=300000
LLM_MAX_OUTPUT_TOKENS_ANALYST=7000
LLM_MAX_OUTPUT_TOKENS_PRODUCER=8000
LLM_MAX_OUTPUT_TOKENS_CRITIC=4500
LLM_MAX_OUTPUT_TOKENS_ORCHESTRATOR_FINAL=8000

# Local PostgreSQL only. Override these values in your untracked .env file when needed.
POSTGRES_DB=your_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Better Auth. Generate BETTER_AUTH_SECRET with a cryptographically secure source;
# it must be at least 32 characters and must never be committed.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
# Resend API key and a verified production sender address. Keep both values only in .env/secret storage.
RESEND_API_KEY=re_replace-with-your-resend-api-key
AUTH_EMAIL_FROM=no-reply@auth.example.com
# Set this only to a header that your production reverse proxy overwrites.
AUTH_CLIENT_IP_HEADER=x-real-ip
