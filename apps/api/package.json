{
  "name": "@job-ai-assistant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "invites:create": "tsx src/cli/create-invite.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "start": "node dist/main.js",
    "test": "npm run prisma:generate && node --import tsx --import ./test/setup-env.ts --test test/**/*.test.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.26",
    "@job-ai-assistant/contracts": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.26",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0"
  }
}
