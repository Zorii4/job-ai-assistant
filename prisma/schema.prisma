generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  inviteId      String    @unique
  planCode      PlanCode  @default(ALPHA)
  initialAnalysisUnitsUsed Int @default(0)
  accounts      Account[]
  sessions      Session[]
  resumes       Resume[]
  applicationCases ApplicationCase[]
  invite        Invite    @relation(fields: [inviteId], references: [id], onDelete: Restrict)

  @@map("user")
}

enum PlanCode {
  ALPHA
}

enum ResumeSourceType {
  FILE
}

enum SanitizationStatus {
  PENDING_REVIEW
  CONFIRMED
}

model Resume {
  id                  String             @id @default(cuid())
  userId              String
  title               String
  sourceType          ResumeSourceType
  slot                Int
  sourceFileName      String?
  sourceText          String
  sanitizedText       String
  sanitizationStatus  SanitizationStatus @default(PENDING_REVIEW)
  sanitizationVersion String
  confirmedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationCases    ApplicationCase[]

  @@index([userId, updatedAt])
  @@unique([userId, slot])
  @@map("resume")
}

enum VacancySourceType {
  FILE
}

enum ApplicationCaseStatus {
  DRAFT
  ANALYZING
  ANALYSIS_READY
  APPLIED
  WAITING_RESPONSE
  HR_INVITED
  HR_PREPARATION_READY
  HR_COMPLETED
  REJECTED
  OFFER
  ARCHIVED
  FAILED
}

enum StageEventSource {
  USER
  SYSTEM
  AI
}

model ApplicationCase {
  id                   String                @id @default(cuid())
  userId               String
  resumeId             String
  title                String
  vacancySourceType    VacancySourceType
  vacancySourceFileName String?
  vacancySourceText    String
  vacancySanitizedText String
  resumeSanitizedText  String
  status               ApplicationCaseStatus @default(DRAFT)
  currentStage         String                @default("DRAFT")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume               Resume                @relation(fields: [resumeId], references: [id], onDelete: Restrict)
  analysisRuns         AnalysisRun[]
  artifacts            Artifact[]
  stageEvents          StageEvent[]

  @@index([userId, updatedAt])
  @@index([resumeId])
  @@map("application_case")
}

model StageEvent {
  id                String           @id @default(cuid())
  applicationCaseId String
  fromStage         ApplicationCaseStatus
  toStage           ApplicationCaseStatus
  source            StageEventSource
  createdAt         DateTime         @default(now())
  applicationCase   ApplicationCase  @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)

  @@index([applicationCaseId, createdAt])
  @@map("stage_event")
}

enum AnalysisWorkflowType {
  INITIAL_ANALYSIS
  HR_PREPARATION
}

enum AnalysisRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ArtifactType {
  RESUME_RECOMMENDATIONS
  COVER_LETTER
  RECRUITER_MESSAGE
  FOLLOW_UP
  HR_SCREENING_PREPARATION
}

model AnalysisRun {
  id                String               @id @default(cuid())
  applicationCaseId String
  workflowType      AnalysisWorkflowType
  status            AnalysisRunStatus    @default(QUEUED)
  currentStage      String?
  model             String?
  promptVersion     String?
  startedAt         DateTime?
  finishedAt        DateTime?
  errorCode         String?
  errorMessageSanitized String?
  queueJobId        String?              @unique
  finalMarkdown     String?
  editedFinalMarkdown String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  applicationCase   ApplicationCase      @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  artifacts         Artifact[]

  @@index([applicationCaseId, createdAt])
  @@index([status, createdAt])
  @@unique([applicationCaseId, workflowType])
  @@map("analysis_run")
}

model Artifact {
  id                String       @id @default(cuid())
  applicationCaseId String
  type              ArtifactType
  generatedContent  String
  editedContent     String?
  sourceRunId       String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  applicationCase   ApplicationCase @relation(fields: [applicationCaseId], references: [id], onDelete: Cascade)
  sourceRun         AnalysisRun  @relation(fields: [sourceRunId], references: [id], onDelete: Cascade)

  @@unique([applicationCaseId, type])
  @@index([sourceRunId])
  @@map("artifact")
}

model Invite {
  id        String    @id
  codeHash  String    @unique
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?

  @@index([email])
  @@index([expiresAt])
  @@map("invite")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
